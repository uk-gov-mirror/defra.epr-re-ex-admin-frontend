{
  "name": "epr-re-ex-admin-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Admin UI for the Re-Ex packaging Extended Producer Responsibilities service (pEPR)",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#server/*": "./src/server/*",
    "#vite/*": "./.vite/*"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "schema:compile": "ajv compile --all-errors --verbose --data -c ajv-formats -s ./src/server/common/schemas/organisation.json -o ./src/server/common/schemas/organisation.ajv.js --code-es5 && node -e \"const fs=require('fs');const f='./src/server/common/schemas/organisation.ajv.js';fs.writeFileSync(f,'// @ts-nocheck\\n'+fs.readFileSync(f,'utf8'))\"",
    "build:frontend": "NODE_ENV=production webpack",
    "dev": "run-p frontend:watch server:watch",
    "dev:debug": "run-p frontend:watch server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "frontend:watch": "NODE_ENV=development webpack --watch",
    "postinstall": "npm run setup:husky",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "lint:types": "tsc -p jsconfig.typecheck.json",
    "lint:types:tests": "tsc -p jsconfig.typecheck.tests.json",
    "lint:types:strict": "tsc -p jsconfig.typecheck.strict.json",
    "pretest": "npm run build:frontend",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch --polling-interval 1000 ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node --use-strict .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.1",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@fast-csv/format": "5.0.7",
    "@hapi/bell": "13.1.0",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/cookie": "12.0.1",
    "@hapi/crumb": "9.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/jwt": "3.2.4",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "ajv": "8.20.0",
    "aws-embedded-metrics": "4.2.1",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "8.0.6",
    "cssnano-preset-default": "8.0.6",
    "date-fns": "4.4.0",
    "global-agent": "3.0.0",
    "govuk-frontend": "6.4.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "6.0.0",
    "joi": "18.2.5",
    "jose": "6.2.9",
    "jsoneditor": "10.4.3",
    "lodash": "4.18.1",
    "nunjucks": "3.2.4",
    "openid-client": "6.8.6",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "semver": "7.8.5",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.5.4",
    "babel-loader": "10.1.1",
    "cheerio": "1.2.0",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "eslint": "9.39.2",
    "eslint-plugin-jsdoc": "63.3.3",
    "happy-dom": "20.11.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "mini-css-extract-plugin": "2.10.2",
    "msw": "2.15.0",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "parse-gitignore": "2.0.0",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "8.2.1",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "sass-embedded": "1.100.0",
    "sass-loader": "17.0.0",
    "source-map-loader": "5.0.0",
    "style-loader": "4.0.0",
    "stylelint": "17.14.1",
    "stylelint-config-gds": "2.0.0",
    "terser-webpack-plugin": "5.6.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "webpack": "5.109.2",
    "webpack-assets-manifest": "6.5.2",
    "webpack-cli": "7.2.2"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "postcss": "8.5.26",
    "jsoneditor": {
      "ajv": "6.14.0"
    },
    "ajv-cli": {
      "fast-json-patch": "3.1.1",
      "js-yaml": "3.15.1"
    },
    "stylelint-config-gds": {
      "stylelint": "$stylelint"
    }
  }
}
