{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% macro link(url, text) -%}
  <a class="govuk-link govuk-link--no-visited-state" href="{{ url }}">{{ text }}</a>
{%- endmacro %}

{#
  A registration's summary list. The accreditation rows show only with
  params.registration.accreditation, and the waste records row only with
  params.wasteRecordsDownloadUrl.
#}
{% macro registrationSummary(params) %}
  {% set registration = params.registration %}
  {% set wasteBalance = params.wasteBalance %}
  {% set summaryRows = [
    { key: { text: "Status" }, value: { html: govukTag({ text: registration.status }) } },
    { key: { text: "Processing type" }, value: { text: registration.processingType } },
    { key: { text: "Material" }, value: { text: registration.material } },
    { key: { text: "Site" }, value: { text: registration.site } }
  ] %}
  {% if registration.accreditation %}
    {% set summaryRows = summaryRows.concat([
      { key: { text: "Accreditation number" }, value: { text: registration.accreditation.accreditationNumber } },
      { key: { text: "Accreditation status" }, value: { html: govukTag({ text: registration.accreditation.status }) } },
      { key: { text: "Waste balance (tonnes)" }, value: { text: wasteBalance.amount if wasteBalance else "No data" } },
      { key: { text: "Waste balance available (tonnes)" }, value: { text: wasteBalance.availableAmount if wasteBalance else "No data" } }
    ]) %}
    {# The December split is surfaced only when the balance carries one, so an
       output accreditation reads as having no December portion rather than a
       misleading zero. A materialised zero (an eligible in-window balance with
       an empty December pool) is a defined value and still renders. This relies
       on the backend omitting the keys entirely when there is no December
       portion: were it to send null or zero, `is defined` would be true and the
       rows would reappear with a blank value. #}
    {% if wasteBalance and wasteBalance.decemberAmount is defined %}
      {% set summaryRows = summaryRows.concat([
        { key: { text: "December waste balance (tonnes)" }, value: { text: wasteBalance.decemberAmount } },
        { key: { text: "December waste balance available (tonnes)" }, value: { text: wasteBalance.decemberAvailableAmount } }
      ]) %}
    {% endif %}
    {% set summaryRows = summaryRows.concat([
      { key: { text: "Waste balance events" }, value: { html: link(params.wasteBalanceEventsUrl, "View") } }
    ]) %}
    {% if params.isExporter %}
      {% set summaryRows = summaryRows.concat([
        { key: { text: "Overseas sites" }, value: { html: link(params.overseasSitesUrl, "View") } }
      ]) %}
    {% endif %}
  {% endif %}

  {% if params.wasteRecordsDownloadUrl %}
    {% set summaryRows = summaryRows.concat([
      { key: { text: "Waste records" }, value: { html: link(params.wasteRecordsDownloadUrl, "Download") } }
    ]) %}
  {% endif %}
  {% if registration.accreditation %}
    {% set summaryRows = summaryRows.concat([
      { key: { text: "PRN activity" }, value: { html: link(params.prnActivityDownloadUrl, "Download") } }
    ]) %}
  {% endif %}

  <div class="govuk-grid-row">
    {# Two-thirds so multi-action rows (e.g. Approve | Reject) keep their
       links horizontally aligned on one line instead of wrapping into a stack. #}
    <div class="govuk-grid-column-two-thirds">
      {{ govukSummaryList({ rows: summaryRows }) }}
    </div>
  </div>
{% endmacro %}
